{
  "openapi": "3.1.0",
  "info": {
    "title": "Metro Safety AI - Modular Monolith API",
    "description": "Computer Vision passenger detection, tracking, crowd analytics and alert monitoring.",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health Check",
        "description": "Process health and runtime readiness check. Does not execute model inference.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cameras": {
      "get": {
        "tags": [
          "cameras"
        ],
        "summary": "List Cameras",
        "description": "Lists all configured camera sources with operational status.",
        "operationId": "list_cameras_api_v1_cameras_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/CameraResponse"
                  },
                  "type": "array",
                  "title": "Response List Cameras Api V1 Cameras Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "cameras"
        ],
        "summary": "Register Camera",
        "description": "Registers a new camera feed.",
        "operationId": "register_camera_api_v1_cameras_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CameraRegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CameraResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cameras/{camera_id}": {
      "get": {
        "tags": [
          "cameras"
        ],
        "summary": "Get Camera",
        "description": "Retrieves metadata and current status for a camera.",
        "operationId": "get_camera_api_v1_cameras__camera_id__get",
        "parameters": [
          {
            "name": "camera_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Camera Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CameraResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cameras/{camera_id}/start": {
      "post": {
        "tags": [
          "cameras"
        ],
        "summary": "Start Camera",
        "description": "Starts camera ingest worker and 1 Hz randomized frame sampling.",
        "operationId": "start_camera_api_v1_cameras__camera_id__start_post",
        "parameters": [
          {
            "name": "camera_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Camera Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cameras/{camera_id}/stop": {
      "post": {
        "tags": [
          "cameras"
        ],
        "summary": "Stop Camera",
        "description": "Stops camera decoder worker cleanly.",
        "operationId": "stop_camera_api_v1_cameras__camera_id__stop_post",
        "parameters": [
          {
            "name": "camera_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Camera Id"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cameras/{camera_id}/snapshot": {
      "get": {
        "tags": [
          "cameras"
        ],
        "summary": "Get Camera Snapshot",
        "description": "Fetches the latest analytics snapshot for this camera.",
        "operationId": "get_camera_snapshot_api_v1_cameras__camera_id__snapshot_get",
        "parameters": [
          {
            "name": "camera_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Camera Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AnalyticsSnapshot"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cameras/{camera_id}/frame.jpg": {
      "get": {
        "tags": [
          "cameras"
        ],
        "summary": "Get Camera Frame",
        "description": "Returns the most recently analyzed frame JPEG image (dummy 1x1 jpeg for contract tests).",
        "operationId": "get_camera_frame_api_v1_cameras__camera_id__frame_jpg_get",
        "parameters": [
          {
            "name": "camera_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Camera Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/metrics": {
      "get": {
        "tags": [
          "analytics"
        ],
        "summary": "Get System Metrics",
        "description": "Retrieves end-to-end system and runtime benchmark metrics.",
        "operationId": "get_system_metrics_api_v1_metrics_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemMetricsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/events": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Query Events",
        "description": "Queries alert event history with optional filters.",
        "operationId": "query_events_api_v1_events_get",
        "parameters": [
          {
            "name": "camera_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by camera_id",
              "title": "Camera Id"
            },
            "description": "Filter by camera_id"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by anomaly type",
              "title": "Type"
            },
            "description": "Filter by anomaly type"
          },
          {
            "name": "severity",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by severity level",
              "title": "Severity"
            },
            "description": "Filter by severity level"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/AlertEvent"
                  },
                  "title": "Response Query Events Api V1 Events Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/events/{event_id}": {
      "get": {
        "tags": [
          "events"
        ],
        "summary": "Get Event",
        "description": "Retrieves single alert event details.",
        "operationId": "get_event_api_v1_events__event_id__get",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Event Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertEvent"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/events/{event_id}/ack": {
      "post": {
        "tags": [
          "events"
        ],
        "summary": "Acknowledge Event",
        "description": "Acknowledges an alert event by station operator.",
        "operationId": "acknowledge_event_api_v1_events__event_id__ack_post",
        "parameters": [
          {
            "name": "event_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Event Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AckRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertEvent"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AckRequest": {
        "properties": {
          "actor_id": {
            "type": "string",
            "title": "Actor Id",
            "default": "operator_1"
          }
        },
        "type": "object",
        "title": "AckRequest"
      },
      "AlertEvent": {
        "properties": {
          "event_id": {
            "type": "string",
            "title": "Event Id",
            "description": "Unique event UUID. Stable across updates to the same ongoing incident."
          },
          "camera_id": {
            "type": "string",
            "title": "Camera Id",
            "description": "Camera where the anomaly was detected"
          },
          "type": {
            "type": "string",
            "enum": [
              "DENSITY_HIGH",
              "PLATFORM_INTRUSION",
              "WRONG_DIRECTION",
              "LOITERING"
            ],
            "title": "Type",
            "description": "Type of anomaly alert"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning",
              "critical"
            ],
            "title": "Severity",
            "description": "Urgency level"
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "acknowledged",
              "resolved"
            ],
            "title": "Status",
            "description": "Lifecycle status",
            "default": "new"
          },
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At",
            "description": "UTC timestamp when the event condition occurred/updated"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence",
            "description": "Confidence of the rule trigger"
          },
          "evidence": {
            "additionalProperties": true,
            "type": "object",
            "title": "Evidence",
            "description": "Diagnostic payload (ROI, track ID, dwell, etc.)"
          },
          "acknowledged_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Acknowledged At",
            "description": "UTC timestamp of operator acknowledgement"
          },
          "resolved_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resolved At",
            "description": "UTC timestamp when condition normalized"
          }
        },
        "type": "object",
        "required": [
          "event_id",
          "camera_id",
          "type",
          "severity",
          "occurred_at",
          "confidence"
        ],
        "title": "AlertEvent"
      },
      "AnalyticsSnapshot": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "description": "Contract schema version",
            "default": "1.0"
          },
          "camera_id": {
            "type": "string",
            "title": "Camera Id",
            "description": "Camera ID for which analytics were computed"
          },
          "sampled_at": {
            "type": "string",
            "format": "date-time",
            "title": "Sampled At",
            "description": "Timestamp of the sampled frame analyzed"
          },
          "visible_detection_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Visible Detection Count",
            "description": "Total persons detected in this single frame"
          },
          "active_track_count": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Active Track Count",
            "description": "Active trajectories currently tracked by ByteTrack"
          },
          "roi_counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Roi Counts",
            "description": "Counts broken down per designated ROI"
          },
          "density": {
            "$ref": "#/components/schemas/DensityInfo",
            "description": "Overall or primary ROI crowd density evaluation"
          },
          "inference_ms": {
            "type": "number",
            "minimum": 0.0,
            "title": "Inference Ms",
            "description": "Inference latency of detector"
          },
          "pipeline_ms": {
            "type": "number",
            "minimum": 0.0,
            "title": "Pipeline Ms",
            "description": "Total analytics processing latency"
          },
          "sample_age_ms": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Sample Age Ms",
            "description": "Time elapsed from capture to snapshot generation in ms"
          }
        },
        "type": "object",
        "required": [
          "camera_id",
          "sampled_at",
          "visible_detection_count",
          "active_track_count",
          "density",
          "inference_ms",
          "pipeline_ms",
          "sample_age_ms"
        ],
        "title": "AnalyticsSnapshot"
      },
      "CameraRegisterRequest": {
        "properties": {
          "camera_id": {
            "type": "string",
            "title": "Camera Id",
            "description": "Unique camera identifier"
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Human readable station/camera label"
          },
          "source_ref": {
            "type": "string",
            "title": "Source Ref",
            "description": "Filepath, MP4 path, or RTSP URL"
          },
          "config": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Config"
          }
        },
        "type": "object",
        "required": [
          "camera_id",
          "name",
          "source_ref"
        ],
        "title": "CameraRegisterRequest"
      },
      "CameraResponse": {
        "properties": {
          "camera_id": {
            "type": "string",
            "title": "Camera Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "source_ref": {
            "type": "string",
            "title": "Source Ref"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "last_sampled_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Sampled At"
          },
          "sample_age_ms": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sample Age Ms"
          }
        },
        "type": "object",
        "required": [
          "camera_id",
          "name",
          "source_ref",
          "status"
        ],
        "title": "CameraResponse"
      },
      "DensityInfo": {
        "properties": {
          "class": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ],
            "title": "Class",
            "description": "Categorical density state"
          },
          "score": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Score",
            "description": "Normalized density score or occupancy ratio"
          },
          "thresholds_version": {
            "type": "string",
            "title": "Thresholds Version",
            "description": "Identifier for active ROI threshold configuration"
          }
        },
        "type": "object",
        "required": [
          "class",
          "score",
          "thresholds_version"
        ],
        "title": "DensityInfo"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "model_loaded": {
            "type": "boolean",
            "title": "Model Loaded"
          },
          "gpu_name": {
            "type": "string",
            "title": "Gpu Name"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "model_loaded",
          "gpu_name",
          "version"
        ],
        "title": "HealthResponse"
      },
      "SystemMetricsResponse": {
        "properties": {
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "active_cameras_count": {
            "type": "integer",
            "title": "Active Cameras Count"
          },
          "sample_rate_hz": {
            "type": "number",
            "title": "Sample Rate Hz"
          },
          "dropped_samples_total": {
            "type": "integer",
            "title": "Dropped Samples Total"
          },
          "p50_latency_ms": {
            "type": "number",
            "title": "P50 Latency Ms"
          },
          "p95_latency_ms": {
            "type": "number",
            "title": "P95 Latency Ms"
          },
          "avg_inference_ms": {
            "type": "number",
            "title": "Avg Inference Ms"
          },
          "avg_pipeline_ms": {
            "type": "number",
            "title": "Avg Pipeline Ms"
          },
          "gpu_memory_used_mb": {
            "type": "number",
            "title": "Gpu Memory Used Mb"
          }
        },
        "type": "object",
        "required": [
          "timestamp",
          "active_cameras_count",
          "sample_rate_hz",
          "dropped_samples_total",
          "p50_latency_ms",
          "p95_latency_ms",
          "avg_inference_ms",
          "avg_pipeline_ms",
          "gpu_memory_used_mb"
        ],
        "title": "SystemMetricsResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}