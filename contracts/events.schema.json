{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WebSocketEventEnvelope",
  "type": "object",
  "required": ["schema_version", "event_id", "type", "occurred_at", "camera_id", "data"],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": ["1.0"]
    },
    "event_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "camera.status.changed",
        "frame.sampled",
        "analytics.snapshot.updated",
        "alert.created",
        "alert.acknowledged",
        "pipeline.metrics.updated",
        "heartbeat"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "camera_id": {
      "type": "string"
    },
    "data": {
      "type": "object"
    }
  }
}
